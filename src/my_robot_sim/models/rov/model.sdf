<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="ROV">
    <pose>0 0 -0.4 0 0 0</pose>

    <!-- Main floating box -->
    <link name="base_link">
      <inertial>
        <pose>0 0 -0.07 0 0 0</pose>
        <mass>7.475</mass> <!-- neutral for volume 0.007875 m^3 in water -->
          <inertia>
          <ixx>0.02953125</ixx>
          <iyy>0.09515625</iyy>
          <izz>0.09515625</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.35 0.15 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.35 0.15 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.15 0.15 1</ambient>
          <diffuse>0.9 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>/rov/imu</topic>
      </sensor>

      <sensor name="scanning_sonar_internal_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>

        <!-- Internal topic. Dashboard should NOT use this directly. -->
        <topic>/rov/scanning_sonar/internal_scan</topic>

        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1416</min_angle>
              <max_angle>3.1416</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000</water_density>

      <!-- Linear damping -->
      <xU>-6</xU>
      <yV>-12</yV>
      <zW>-14</zW>
      <kP>-0.4</kP>
      <mQ>-0.8</mQ>
      <nR>-0.8</nR>

      <!-- Quadratic damping -->
      <xUabsU>-12</xUabsU>
      <yVabsV>-20</yVabsV>
      <zWabsW>-24</zWabsW>
      <kPabsP>-0.02</kPabsP>
      <mQabsQ>-0.2</mQabsQ>
      <nRabsR>-0.2</nRabsR>
    </plugin>

    <link name="left_thrusters">
      <pose relative_to="base_link">0 0.105 0 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="left_thruster_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_thrusters</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <link name="right_thrusters">
      <pose relative_to="base_link">0 -0.105 0 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="right_thruster_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_thrusters</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ================= TUTORIAL-STYLE GRIPPER ================= -->

    <link name="gripper_palm">
      <pose relative_to="base_link">0.22 0 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.192</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <iyy>0.00005</iyy>
          <izz>0.00005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.12 0.04</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.12 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="gripper_palm_joint" type="fixed">
      <parent>base_link</parent>
      <child>gripper_palm</child>
    </joint>

    <link name="left_gripper_finger">
      <pose relative_to="base_link">0.27 0.075 -0.05 0 0 -0.45</pose>

      <inertial>
        <mass>0.182</mass>
        <inertia>
          <ixx>0.00003</ixx>
          <iyy>0.00003</iyy>
          <izz>0.00003</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.13 0.035</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>6000</kp>
              <kd>80</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.13 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_gripper_tip">
      <pose relative_to="base_link">0.36 0.095 -0.05 0 0 0.75</pose>

      <inertial>
        <mass>0.126</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.09 0.035</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>6000</kp>
              <kd>80</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.09 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_gripper_finger">
      <pose relative_to="base_link">0.27 -0.075 -0.05 0 0 0.45</pose>

      <inertial>
        <mass>0.182</mass>
        <inertia>
          <ixx>0.00003</ixx>
          <iyy>0.00003</iyy>
          <izz>0.00003</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.13 0.035</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>6000</kp>
              <kd>80</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.13 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_gripper_tip">
      <pose relative_to="base_link">0.36 -0.095 -0.05 0 0 -0.75</pose>

      <inertial>
        <mass>0.126</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.09 0.035</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>6000</kp>
              <kd>80</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.09 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="palm_left_finger_joint" type="revolute">
      <parent>gripper_palm</parent>
      <child>left_gripper_finger</child>
      <pose relative_to="base_link">0.235 0.055 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1.5</effort>
          <velocity>0.6</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="left_finger_tip_joint" type="revolute">
      <parent>left_gripper_finger</parent>
      <child>left_gripper_tip</child>
      <pose relative_to="base_link">0.32 0.10 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1.0</effort>
          <velocity>0.6</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="palm_right_finger_joint" type="revolute">
      <parent>gripper_palm</parent>
      <child>right_gripper_finger</child>
      <pose relative_to="base_link">0.235 -0.055 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1.5</effort>
          <velocity>0.6</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_finger_tip_joint" type="revolute">
      <parent>right_gripper_finger</parent>
      <child>right_gripper_tip</child>
      <pose relative_to="base_link">0.32 -0.10 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.7</lower>
          <upper>0.7</upper>
          <effort>1.0</effort>
          <velocity>0.6</velocity>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0.2</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>left_thruster_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>false</velocity_control>
      <max_thrust_cmd>30</max_thrust_cmd>
      <min_thrust_cmd>-30</min_thrust_cmd>
    </plugin>

    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>rov</namespace>
      <joint_name>right_thruster_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>false</velocity_control>
      <max_thrust_cmd>30</max_thrust_cmd>
      <min_thrust_cmd>-30</min_thrust_cmd>
    </plugin>

    <plugin filename="BallastTankPlugin"
          name="my_plugins::BallastTankPlugin">
      <link_name>base_link</link_name>
      <topic>/rov/ballast_cmd</topic>
      <max_weight>0.8</max_weight>
      <initial_weight>0.0</initial_weight>
      <fill_rate>0.06</fill_rate>
    </plugin>

    <plugin filename="libPressureSensorPlugin.so"
      name="my_plugins::PressureSensorPlugin">
      <parent_link_name>base_link</parent_link_name>

      <!-- Sensor port location on hull, relative to base_link -->
      <port_offset>0 0 -0.06</port_offset>

      <!-- Only matters if dynamic_pressure_coeff > 0 -->
      <port_axis_local>1 0 0</port_axis_local>

      <water_surface_z>0.0</water_surface_z>
      <atmospheric_pressure_pa>101325.0</atmospheric_pressure_pa>
      <water_density_kgpm3>997.0</water_density_kgpm3>
      <gravity_mps2>9.81</gravity_mps2>

      <update_rate_hz>30.0</update_rate_hz>

      <!-- realism -->
      <bias_pa>0.0</bias_pa>
      <noise_stddev_pa>120.0</noise_stddev_pa>
      <drift_stddev_pa_per_sqrt_s>3.0</drift_stddev_pa_per_sqrt_s>
      <tau_seconds>0.08</tau_seconds>
      <quantization_pa>10.0</quantization_pa>

      <!-- keep 0 for normal depth sensor -->
      <dynamic_pressure_coeff>0.0</dynamic_pressure_coeff>

      <clamp_above_surface>true</clamp_above_surface>

      <pressure_topic>/rov/pressure</pressure_topic>
      <depth_topic>/rov/depth/current</depth_topic>
    </plugin>    

    <link name="camera_link">
      <pose relative_to="base_link">0.18 0 0.05 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>
      </visual>

      <!-- Small visible LED body -->
      <visual name="front_led_visual">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 0.4 1</ambient>
          <diffuse>1 1 0.4 1</diffuse>
          <emissive>1 1 0.3 1</emissive>
        </material>
      </visual>

      <!-- Actual attached spotlight -->
      <light name="front_led_light" type="spot">
        <pose>0 0 -0.05 0 0 0</pose>

        <intensity>0.0</intensity>
        <diffuse>1 1 0.8 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
        <cast_shadows>true</cast_shadows>

        <attenuation>
          <range>8</range>
          <constant>0.5</constant>
          <linear>0.05</linear>
          <quadratic>0.01</quadratic>
        </attenuation>

        <!-- Forward direction of camera_link -->
        <direction>1 0 0</direction>

        <spot>
          <inner_angle>0.35</inner_angle>
          <outer_angle>0.8</outer_angle>
          <falloff>1.0</falloff>
        </spot>
      </light>

      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/sim/camera/image</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <plugin
      filename="libSpotLightPlugin.so"
      name="rov_gz_plugins::RovSpotLightPlugin">

      <light_name>front_led_light</light_name>
      <topic>/rov/light/cmd</topic>
      <on_intensity>1.0</on_intensity>
    </plugin>

    <plugin
      filename="libScanningSonarPlugin.so"
      name="rov_gz_plugins::ScanningSonarPlugin">

      <input_scan_topic>/rov/scanning_sonar/internal_scan</input_scan_topic>
      <topic>/rov/scanning_sonar/reading</topic>

      <!-- Radians: -180 deg to +180 deg -->
      <min_angle>-3.1416</min_angle>
      <max_angle>3.1416</max_angle>

      <!-- Messages per second -->
      <frequency>10</frequency>

      <!-- 5 degrees per message = full scan in about 7.2 seconds at 10 Hz -->
      <angle_step>0.0873</angle_step>

      <min_distance>0.10</min_distance>
      <max_distance>8.0</max_distance>
      <resolution>0.01</resolution>

      <!-- Optional -->
      <noise_stddev>0.02</noise_stddev>
      <ping_pong>false</ping_pong>
    </plugin>

    <!-- ================= FORCE-BASED GRIPPER PLUGIN ================= -->

    <plugin
      filename="libRovGripperPlugin.so"
      name="rov_gz_plugins::RovGripperPlugin">

      <topic>/rov/gripper/open_cmd</topic>

      <left_joint>palm_left_finger_joint</left_joint>
      <right_joint>palm_right_finger_joint</right_joint>

      <main_force>5.0</main_force>

      <left_close_sign>-1</left_close_sign>
      <right_close_sign>1</right_close_sign>
    </plugin>
  </model>
</sdf>